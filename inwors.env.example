# Copy these values to the InWorS .env file when the React app is served
# from the same host as Django. For local Vite development, replace the host
# with http://127.0.0.1:8000 if Vite is running on another port.
VITE_LOAD_URL=/api/bim/location-models
VITE_SAVE_URL=/api/bim/location-models
VITE_LOCATIONS_URL=/api/bim/locations/
VITE_OBJECTS_URL=/api/bim/objects/
VITE_TASKS_URL=/api/bim/tasks/
VITE_EXPORT_IFC_URL=
VITE_INFO_URL=/equipment/
VITE_TASK_PAGE_URL=/applications/
VITE_LOCATIONS_PAGE_URL=/locations/
